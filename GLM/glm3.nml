&glm_setup
   sim_name = 'GLMSimulation'
   max_layers = 11
   min_layer_vol = 0.1
   min_layer_thick = 0.15
   max_layer_thick = 1
   density_model = 1
/
&light
   light_mode = 0
   n_bands = 4
   light_extc = 1, 0.5, 2, 4
   energy_frac = 0.51, 0.45, 0.035, 0.005
   Benthic_Imin = 10
   Kw = 0.98
/
&mixing
   surface_mixing = 1
   coef_mix_conv = 0.2
   coef_wind_stir = 0.23
   coef_mix_shear = 0.3
   coef_mix_turb = 0.51
   coef_mix_KH = 0.3
   coef_mix_hyp = 0.5
   deep_mixing = 2
   diff = 0
/
&morphometry
   lake_name = 'SMALL_POND'
   latitude = 50
   longitude = 8
   bsn_len = 11,
   bsn_wid = 4.5,
   bsn_vals = 4
   H = 214, 214.3, 214.6, 215
   A = 49.5, 95.04, 140.49, 176.25
   crest_elev = 215
/
&time
   timefmt = 2
   start = '2020-07-22 00:00:00'
   stop = '2021-06-14 00:00:00'
   dt = 600
   num_days = 730
   timezone = 0
/
&output
   out_dir = 'output'
   out_fn = 'output'
   nsave = 1
   csv_lake_fname = 'lake'
/
&init_profiles
   lake_depth = 0.3
   num_depths = 6
   the_depths = 0.3, 0.25, 0.2, 0.15, 0.1, 0.05
   the_temps = 15.74, 6.548, 20.14, 7.742, 9.441, 18.76
   the_sals = 0, 0, 0, 0, 0, 0
/
&meteorology
   met_sw = .true.
   lw_type = 'LW_IN'
   rain_sw = .false.
   atm_stab = 0
   catchrain = .false.
   rad_mode = 1
   albedo_mode = 1
   cloud_mode = 4
   meteo_fl = 'meteo_file.csv'
   subdaily = .true.
   wind_factor = 1
   sw_factor = 1
   lw_factor = 1
   at_factor = 1
   rh_factor = 1
   rain_factor = 1
   cd = 0.0013
   ce = 0.0013
   ch = 0.0013
   rain_threshold = 0.01
   runoff_coef = 0.3
   time_fmt = 'YYYY-MM-DD hh:mm:ss'
/
&inflow
   num_inflows = 0
   names_of_strms = 'Riv1','Riv2'
   subm_flag = .false., .false.
   strm_hf_angle = 65, 65
   strmbd_slope = 1.5, 1.5
   strmbd_drag = 0.016, 0.016
   inflow_factor = 1, 1
   inflow_fl = 'Riv1.csv','Riv2.csv'
   inflow_varnum = 3
   inflow_vars = 'FLOW','SALT','TEMP'
/
&outflow
   num_outlet = 0
   outl_elvs = 214
   bsn_len_outl = 799
   bsn_wid_outl = 398
   outflow_fl = 'RivOutflow.csv'
   outflow_factor = 1
   flt_off_sw = .false.
   crest_width = 100
   crest_factor = 0.61
/
&snowice
   snow_albedo_factor = 1
   snow_rho_max = 500
   snow_rho_min = 100
/
