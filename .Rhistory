# Initialize vectors to store wind_speed and swr values
all_wind_speed <- c()
all_swr <- c()
# Function to extract wind_speed and swr for a given model
extract_values <- function(model_name) {
# Extract dataframes for the model from each list
df_rmse <- best_p_rmse[[model_name]]
df_nse <- best_p_nse[[model_name]]
df_mae <- best_p_mae[[model_name]]
# Combine the dataframes
combined_df <- rbind(df_rmse, df_nse, df_mae)
# Append wind_speed and swr values to the vectors
all_wind_speed <<- c(all_wind_speed, combined_df$wind_speed)
all_swr <<- c(all_swr, combined_df$swr)
}
