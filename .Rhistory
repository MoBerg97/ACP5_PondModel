# turn wide format of EERES Temperature to long format
EERES_Temperature = read_csv("Data/EERES_Temperature.csv")
EERES_T_long = pivot_longer(EERES_Temperature, cols=`30 cm`:`air`, names_to = "Depth_meter", values_to = "Water_Temperature_celsius") %>%
filter(!Depth_meter=="air") %>%
mutate(datetime = as_datetime(time),
Depth_meter =  gsub("[^0-9]", "", Depth_meter)) %>%
mutate(Depth_meter = as.numeric(Depth_meter)/100) %>%
select(-time)
# write Water temperature to csv
write.csv(EERES_T_long,"Data/LakeEnsemblR_wtemp_profile_EERES.csv",row.names=FALSE)
# select and transform Meteorological data
meteo_raw = read_xlsx("Data/20200101-20211231_Wetterstationsdaten_Andreas Lorke.xlsx",
skip = 1, na=c("-99999,9"))
meteo = meteo_raw %>%
mutate(across(where(is.numeric), ~ na_if(., -9999))) %>%
mutate(across(where(is.numeric), ~ na_if(., -99999.9)))
# create datetime column
meteo$time = format(meteo$`~...1`, format = "%H:%M:%S")
meteo$datetime =  as.POSIXct(paste(meteo$`~...2`, meteo$time), format = "%Y-%m-%d %H:%M:%S")
# check for na vlaues
na_df <- meteo %>%
select(SO,TE,FE,TP,WD,WR,RD,DR) %>%
filter(if_any(everything(), is.na))
meteo_h =  meteo %>%
# Create a column for the hour
mutate(hour = floor_date(datetime, "hour")) %>%
# Group by hour column
group_by(hour) %>%
# summarize for each hour
summarise(across(everything(),
list(avg = ~ ifelse(cur_column() == "RD", sum(.), mean(.))),
.names = "{.col}")) %>%
# change hPa to Pa
mutate(DR = DR*100) %>%
# choose the required columns
select(hour,SO,TE,FE,TP,WD,WR,RD,DR) %>%
# name the columns as required
rename(datetime=hour,
Shortwave_Radiation_Downwelling_wattPerMeterSquared=SO,
Air_Temperature_celsius=TE,
Relative_Humidity_percent=FE,
Dewpoint_Temperature_celsius=TP,
Ten_Meter_Elevation_Wind_Speed_meterPerSecond=WD,
Ten_Meter_Elevation_Wind_Direction_degree=WR,
Rainfall_millimeterPerHour=RD,
Surface_Level_Barometric_Pressure_pascal=DR)
# test for missing timesteps
get_missing_datetimes = function(df){
start_time <- as.POSIXct("2020-06-01 00:00:00")
end_time <- as.POSIXct("2021-07-31 00:00:00")
complete_sequence <- seq(from = start_time, to = end_time, by = "hour")
missing_time_steps <- setdiff(complete_sequence, df$datetime)
missing_df <- data.frame(datetime = as.POSIXct(missing_time_steps))
result_df <- missing_df %>%
left_join(df, by = "datetime")
return(result_df)
}
missing_h_1 = get_missing_datetimes(meteo_h)
# some missing time steps are not in simulation time --> drop all rows outside
meteo_h_filtered = meteo_h %>%
ungroup() %>%
filter(as.Date(datetime) > as.Date("2020-06-15 00:00:00") &
as.Date(datetime) < as.Date("2021-07-31 00:00:00"))
# test again
missing_h_2 = get_missing_datetimes(meteo_h_filtered) %>%
filter(as.Date(datetime) > as.Date("2020-06-15 00:00:00") &
as.Date(datetime) < as.Date("2021-07-31 00:00:00"))
print(missing_h_2)
# TODO: Interpolate the missing data
meteo_h_complete = rbind(meteo_h_filtered,missing_h_2) %>%
arrange(datetime)
na.approx(meteo_h_complete, maxgap=Inf)
