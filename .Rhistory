best_quant))
})
names(best_l) <- model
}
else {
best_l <- lapply(model, function(m) {
subset(res[[m]], res[[m]][[qual_met]] > quantile(res[[m]][[qual_met]],
(1 - best_quant)))
})
names(best_l) <- model
}
ret_l <- list()
for (m in model) {
if (!(qual_met %in% colnames(res[[m]]))) {
av_met <- colnames(res[[m]])[!(colnames(res[[m]])) %in%
