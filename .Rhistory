# Initialize a list to store the mean values
mean_values <- list()
# Function to calculate mean values for a given model
calculate_means <- function(model_name) {
# Extract dataframes for the model from each list
df_rmse <- best_p_rmse[[model_name]]
df_nse <- best_p_nse[[model_name]]
df_mae <- best_p_mae[[model_name]]
# Combine the dataframes
combined_df <- rbind(df_rmse, df_nse, df_mae)
# Calculate mean for the specified parameters
mean_wind_speed <- mean(combined_df$wind_speed, na.rm = TRUE)
mean_swr <- mean(combined_df$swr, na.rm = TRUE)
mean_Kw <- mean(combined_df$Kw, na.rm = TRUE)
# Check if the parameter exists in the combined dataframe before calculating mean
mean_a_seiche <- ifelse("a_seiche" %in% colnames(combined_df),
mean(combined_df$a_seiche, na.rm = TRUE), NA)
mean_turb_param_k_min <- ifelse("turb_param.k_min" %in% colnames(combined_df),
mean(combined_df$turb_param.k_min, na.rm = TRUE), NA)
mean_c_relax_C <- ifelse("c_relax_C" %in% colnames(combined_df),
mean(combined_df$c_relax_C, na.rm = TRUE), NA)
# Return the means as a named vector
return(c(mean_wind_speed, mean_swr, mean_Kw, mean_a_seiche, mean_turb_param_k_min, mean_c_relax_C))
}
# Calculate means for each model
mean_values$FLake <- calculate_means("FLake")
mean_values$GOTM <- calculate_means("GOTM")
mean_values$Simstrat <- calculate_means("Simstrat")
# Convert the list to a dataframe for better visualization
mean_values_df <- do.call(rbind, mean_values)
colnames(mean_values_df) <- c("mean_wind_speed", "mean_swr", "mean_Kw", "mean_a_seiche", "mean_turb_param.k_min", "mean_c_relax_C")
# Print the mean values
print(mean_values_df)
knitr::opts_chunk$set(echo = TRUE, results = "hide")
