# get the best parameter set for each model using rmse
best_p_rmse <- setNames(lapply(model, function(m)res_LHC[[m]][which.min(res_LHC[[m]]$rmse), ]), model)
best_p_nse <- setNames(lapply(model, function(m)res_LHC[[m]][which.max(res_LHC[[m]]$nse), ]), model)
best_p_mae <- setNames(lapply(model, function(m)res_LHC[[m]][which.min(res_LHC[[m]]$mae), ]), model)
